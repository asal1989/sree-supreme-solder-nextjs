# Copy to .env.local and set real values. Required to access /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=

# SMTP credentials — required for the contact form and newsletter sign-up
# to send email. Leave unset locally and both routes will respond 503
# rather than silently failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@sreesupremesolder.in
